        "child_node_id": "corridor_passage",
        "new_weight": 10
      },
      "purpose": "Widen the central open passage while narrowing both side-wall regions.",
      "primary_example_edit": true,
      "recommended_render_camera": "isometric"
    }
  ],
  "expected_semantic_classes": ["ceiling", "corridor", "door", "ground", "wall"],
  "expected_split_node_ids": ["corridor_depth_zones", "corridor_vertical_layers", "left_wall_layout", "right_wall_layout", "usable_width_layout"],
